type hal_accessory_default, domain;
hal_server_domain(hal_accessory_default, hal_accessory)

type hal_accessory_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_accessory_default)

allow hal_accessory_default hal_accessory_hwservice:hwservice_manager find;
allow hal_accessory_default self:qipcrtr_socket create;
allow hal_accessory_default sysfs_extcon:dir r_dir_perms;
allow hal_accessory_default sysfs_extcon:file r_file_perms;
